  },
  "devDependencies": {
    "@astrojs/compiler-binding-wasm32-wasi": "0.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "@types/ssh2": "1.15.6",
    "esbuild": "^0.28.2",
    "eslint": "^9",
