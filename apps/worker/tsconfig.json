{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here because render.ts contains code that Playwright runs
    // inside the page. That code really does execute in a browser.
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.mjs"]
}
