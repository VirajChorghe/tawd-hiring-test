# Keep the build context small and secrets out of the image.

.git
.github
.gitignore

node_modules
**/node_modules

.next
**/.next
# Only real build output. Never a bare "build" or "out": "**/build" silently dropped the
# app's own Build page and its components from every image until 29 September 2026.
apps/web/out
coverage
apps/*/coverage
packages/*/coverage

# Secrets live in Coolify environment variables, never in the image.
.env
.env.*

# Docs are not needed by either image. skills/ IS needed: the worker copies
# it in, and the design skills are what it builds concepts with.
*.md
docs

Dockerfile
.dockerignore
*.log
*.tsbuildinfo
.DS_Store
Thumbs.db
.vscode
.idea
